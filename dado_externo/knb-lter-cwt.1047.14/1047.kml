  <Document>
    <Style id="custom-style">
      <BalloonStyle>
        <bgColor>ffcbe9e8</bgColor>
        <textColor>ff000000</textColor>
      </BalloonStyle>
      <LineStyle>
        <color>ff00ffff</color>
